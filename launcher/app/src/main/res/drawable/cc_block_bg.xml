<?xml version="1.0" encoding="utf-8"?>
<!-- The connectivity module: frosted glass that is never focused itself; its round buttons are. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
            <layer-list>
                <item><shape android:shape="rectangle"><solid android:color="#C21E1E22" /><corners android:radius="26dp" /></shape></item>
                <item><shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#0AFFFFFF" android:endColor="#1AFFFFFF" />
                    <stroke android:width="1dp" android:color="#5CFFFFFF" />
                    <corners android:radius="26dp" />
                </shape></item>
            </layer-list>
    </item>
</selector>
