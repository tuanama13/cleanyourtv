<?xml version="1.0" encoding="utf-8"?>
<!-- Round button inside the connectivity module: glass, white when its button is focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#4DFFFFFF" />
        </shape>
    </item>
</selector>
