<?xml version="1.0" encoding="utf-8"?>
<!-- A connected radio (Wi-Fi, Bluetooth): iOS blue, white when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval"><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#FF3D9BFF" android:endColor="#FF0A6CFF" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
</selector>
