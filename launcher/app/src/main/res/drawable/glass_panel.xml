<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdowns (Inputs, menus): darker liquid glass so their rows stay readable over any backdrop. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#E63A3A40" android:centerColor="#D91C1C20" android:endColor="#E0262629" />
    <stroke android:width="1dp" android:color="#4DFFFFFF" />
    <corners android:radius="24dp" />
</shape>
