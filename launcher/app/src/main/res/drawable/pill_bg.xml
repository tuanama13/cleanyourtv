<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid glass: bright top, clear middle, a faint refraction at the bottom and a light rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#E6F2F2F7" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#596EC1FF" />
            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#0DFFFFFF" android:endColor="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
