<?xml version="1.0" encoding="utf-8"?>
<!-- Control center opened by the Settings pill or the remote's Settings button: glass modules of mixed sizes
     floating over the dimmed screen, as on iOS. QuickSettingsActivity places them on the grid. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cc_scrim">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="48dp"
        android:orientation="vertical">

        <GridLayout
            android:id="@+id/rows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="5"
            android:rowCount="3" />
    </LinearLayout>
</FrameLayout>
