<?xml version="1.0" encoding="utf-8"?>
<!-- A square or tall control center module: round icon on top, name and an optional status line at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/cc_tile_bg"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="7dp"
        android:background="@drawable/cc_icon_bg"
        android:tint="@drawable/pill_text"
        android:duplicateParentState="true"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/pill_text"
        android:duplicateParentState="true"
        android:textSize="13sp"
        android:fontFamily="@string/font_medium" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@drawable/pill_text_dim"
        android:duplicateParentState="true"
        android:textSize="11sp"
        android:fontFamily="@string/font_regular"
        android:visibility="gone" />
</LinearLayout>
